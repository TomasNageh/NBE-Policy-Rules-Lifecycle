{
  "name": "nbe-policy-management-backend",
  "version": "1.0.0",
  "description": "Backend API for NBE Policy Management System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ./node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/server.ts",
    "build": "node ./node_modules/rimraf/dist/esm/bin.mjs dist && node ./node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "lint": "node ./node_modules/eslint/bin/eslint.js \"src/**/*.ts\"",
    "lint:fix": "node ./node_modules/eslint/bin/eslint.js \"src/**/*.ts\" --fix",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write \"src/**/*.ts\"",
    "test:auth": "node ./node_modules/ts-node-dev/lib/bin.js --transpile-only src/tests/auth.test.ts",
    "test:policy": "node dist/tests/policy.test.js",
    "test:parser": "node dist/tests/parser.test.js",
    "test:review": "node dist/tests/review.test.js",
    "test:version-diff": "node ./node_modules/ts-node-dev/lib/bin.js --transpile-only src/tests/version-diff.test.ts",
    "test:sla": "node ./node_modules/ts-node-dev/lib/bin.js --transpile-only src/tests/sla.test.ts",
    "test:admin": "node ./node_modules/ts-node-dev/lib/bin.js --transpile-only src/tests/admin.test.ts",
    "test:audit": "node ./node_modules/ts-node-dev/lib/bin.js --transpile-only src/tests/audit-reporting.test.ts",
    "test:notifications": "node ./node_modules/ts-node-dev/lib/bin.js --transpile-only src/tests/notification.test.ts",
    "seed": "node ./node_modules/ts-node-dev/lib/bin.js --transpile-only src/database/seed.ts",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate dev"
  },
  "keywords": [
    "nbe",
    "policy-management",
    "express",
    "prisma",
    "typescript"
  ],
  "author": "National Bank of Egypt",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/diff": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
